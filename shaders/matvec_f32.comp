#version 450

layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Weights { float w[]; };
layout(std430, binding = 1) readonly buffer Scales  { float s[]; };
layout(std430, binding = 2) readonly buffer Input   { float x[]; };
layout(std430, binding = 3) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Params { uint rows; uint input_dim; uint output_dim; } p;

void main() {
    uint linear = gl_GlobalInvocationID.x;
    uint total = p.rows * p.output_dim;
    if (linear >= total) return;
    uint row = linear / p.output_dim;
    uint o = linear - row * p.output_dim;
    float acc = 0.0;
    uint base = o * p.input_dim;
    uint xbase = row * p.input_dim;
    for (uint k = 0u; k < p.input_dim; ++k) {
        acc += w[base + k] * x[xbase + k];
    }
    y[linear] = acc * s[0];
}
