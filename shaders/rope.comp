#version 450
/* Rotary position embedding. One invocation per (head, rotation pair). */

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Data { float d[]; };
layout(push_constant) uniform Params {
    uint head_dim;
    uint n_rot;
    uint n_head;
    uint pos;
    float theta_base;
    uint pairs;
} p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= p.n_head * p.pairs) return;
    uint head = idx / p.pairs;
    uint i = idx % p.pairs;
    uint half_dim = p.head_dim / 2u;
    uint base = head * p.head_dim;
    float freq = float(p.pos) * exp2(-2.0 * float(i) / float(p.head_dim) * log2(p.theta_base));
    float c = cos(freq);
    float s = sin(freq);
    float a = d[base + i];
    float b = d[base + i + half_dim];
    d[base + i] = a * c - b * s;
    d[base + i + half_dim] = a * s + b * c;
}
