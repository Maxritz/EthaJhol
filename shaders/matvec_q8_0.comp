#version 450
#extension GL_EXT_integer_dot_product : require

/* Q8_0 matvec, dp4a. Each workgroup (256 lanes = 8 sub-groups of 32) computes 8
 * output rows: sub-group g does row = wg*8 + g with a 32-lane strided scan of the
 * 32-value weight blocks, then a shared-memory tree reduction inside the
 * sub-group. Processing 8 rows per workgroup amortizes the reduction barriers
 * over 8 rows (a single-row-per-workgroup kernel is dispatch-bound on the
 * 128K-row lm_head). */

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer WQ { uint wq[]; };   /* repacked int8 qs: 8 aligned u32 per block */
layout(std430, binding = 1) readonly buffer WS { uint ws[]; };   /* fp16 scales, 2 per u32 */
layout(std430, binding = 2) readonly buffer XD { float xd[]; };  /* activation scale per block */
layout(std430, binding = 3) readonly buffer XQ { uint xq[]; };   /* quantized activations: 8 u32 per block */
layout(std430, binding = 4) writeonly buffer Y { float y[]; };
layout(push_constant) uniform Params { uint out_dim; uint in_dim; } p;

shared float red[8][32];

float decode_f16(uint h) {
    uint sign = (h >> 15u) & 1u;
    uint exp = (h >> 10u) & 0x1fu;
    uint mantissa = h & 0x3ffu;
    uint f;
    if (exp == 0u) {
        if (mantissa == 0u) { f = sign << 31u; }
        else {
            int e = -1;
            uint m = mantissa;
            do { m <<= 1u; ++e; } while ((m & 0x400u) == 0u);
            m &= 0x3ffu;
            f = (sign << 31u) | (uint(127 - 15 - e) << 23u) | (m << 13u);
        }
    } else if (exp == 31u) { f = (sign << 31u) | 0x7f800000u | (mantissa << 13u); }
    else { f = (sign << 31u) | ((exp + 127u - 15u) << 23u) | (mantissa << 13u); }
    return uintBitsToFloat(f);
}

void main() {
    uint lid  = gl_LocalInvocationID.x;
    uint grp  = lid >> 5u;
    uint lane = lid & 31u;
    uint row  = gl_WorkGroupID.x * 8u + grp;
    uint bpr  = p.in_dim / 32u;

    float acc = 0.0;
    if (row < p.out_dim) {
        for (uint gb = lane; gb < bpr; gb += 32u) {
            uint blk = row * bpr + gb;
            int a = 0;
            for (uint w = 0u; w < 8u; ++w) {
                a += dotPacked4x8EXT(int(wq[blk * 8u + w]), int(xq[gb * 8u + w]));
            }
            uint sw = ws[blk >> 1u];
            uint su = (blk & 1u) == 0u ? (sw & 0xffffu) : (sw >> 16u);
            acc += float(a) * decode_f16(su) * xd[gb];
        }
    }
    red[grp][lane] = acc;
    barrier();
    for (uint s = 16u; s > 0u; s >>= 1u) {
        if (lane < s) red[grp][lane] += red[grp][lane + s];
        barrier();
    }
    if (lane == 0u && row < p.out_dim) y[row] = red[grp][0];
}
