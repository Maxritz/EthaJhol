#version 450
/* RMSNorm over one vector of arbitrary length: out[i] = x[i]/sqrt(mean(x^2)+eps) * w[i]. */

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Input  { float x[]; };
layout(std430, binding = 1) readonly buffer Weight { float w[]; };
layout(std430, binding = 2) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Params { uint dim; float eps; } p;

shared float partial[256];

void main() {
    uint lane = gl_LocalInvocationID.x;
    float ss = 0.0;
    for (uint i = lane; i < p.dim; i += 256u) {
        float v = x[i];
        ss += v * v;
    }
    partial[lane] = ss;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (lane < s) partial[lane] += partial[lane + s];
        barrier();
    }
    float inv = inversesqrt(partial[0] / float(p.dim) + p.eps);
    for (uint i = lane; i < p.dim; i += 256u) {
        y[i] = x[i] * inv * w[i];
    }
}
