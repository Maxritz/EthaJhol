#version 450
// One workgroup per row. Each row is length dim (may exceed the workgroup size).
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer Input  { float x[]; };
layout(std430, binding = 1) readonly  buffer Weight { float w[]; };
layout(std430, binding = 2) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Params { uint dim; float eps; } p;

shared float red[256];

void main() {
    uint row = gl_WorkGroupID.x;
    uint lid = gl_LocalInvocationID.x;
    uint base = row * p.dim;

    float acc = 0.0;
    for (uint i = lid; i < p.dim; i += 256u) { float v = x[base + i]; acc += v * v; }
    red[lid] = acc;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) { if (lid < s) red[lid] += red[lid + s]; barrier(); }
    float inv = 1.0 / sqrt(red[0] / float(p.dim) + p.eps);
    barrier();
    for (uint i = lid; i < p.dim; i += 256u) y[base + i] = x[base + i] * inv * w[i];
}
