#version 450
/* Numerically stable softmax over one vector of arbitrary length. */

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Data { float x[]; };
layout(push_constant) uniform Params { uint dim; } p;

shared float partial[256];

void main() {
    uint lane = gl_LocalInvocationID.x;
    float mx = -3.402823466e+38;
    for (uint i = lane; i < p.dim; i += 256u) mx = max(mx, x[i]);
    partial[lane] = mx;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (lane < s) partial[lane] = max(partial[lane], partial[lane + s]);
        barrier();
    }
    float m = partial[0];
    barrier();
    float sum = 0.0;
    for (uint i = lane; i < p.dim; i += 256u) sum += exp(x[i] - m);
    partial[lane] = sum;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (lane < s) partial[lane] += partial[lane + s];
        barrier();
    }
    float inv = 1.0 / partial[0];
    for (uint i = lane; i < p.dim; i += 256u) x[i] = exp(x[i] - m) * inv;
}
